import { NextResponse } from 'next/server';

export const dynamic = 'force-dynamic';

// กำหนด Bot Token และ Chat ID
const BOT_TOKEN = process.env.TELEGRAM_BOT_TOKEN || '8951440086:AAE57rVKCJXeJbuVqtn9g1AyhBdv71dG9rU';
const CHAT_ID = process.env.TELEGRAM_CHAT_ID || '@webcoffeepos';

const formatMoney = (n) =>
  Number(n || 0).toLocaleString('th-TH', {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  });

const formatThaiDateTime = (value) => {
  const date = value ? new Date(value) : new Date();
  const safe = Number.isNaN(date.getTime()) ? new Date() : date;
  return safe.toLocaleString('th-TH', {
    timeZone: 'Asia/Bangkok',
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
  });
};

function buildMessage({ productName, quantity, totalPrice, soldAt, items }) {
  const lines = ['🛒 ขายสินค้าสำเร็จ!'];

  if (Array.isArray(items) && items.length > 0) {
    lines.push('📦 รายการสินค้า:');
    items.slice(0, 50).forEach((item) => {
      const unit = item.unit ? ` ${item.unit}` : '';
      lines.push(
        `  • ${item.name || 'สินค้า'} x ${item.quantity || 1}${unit} = ${formatMoney(item.lineTotal)} บาท`
      );
    });
    if (quantity) lines.push(`จำนวนรวม: ${quantity}`);
  } else {
    lines.push(`📦 สินค้า: ${productName || 'รายการสินค้า'}`);
    lines.push(`จำนวน: ${quantity || 1}`);
  }

  lines.push(`💰 ยอดรวม: ${formatMoney(totalPrice)} บาท`);
  lines.push(`⏰ เวลา: ${formatThaiDateTime(soldAt)}`);

  return lines.join('\n').slice(0, 4000);
}

export async function POST(request) {
  let body;
  try {
    body = await request.json();
  } catch {
    return NextResponse.json(
      { status: 'error', message: 'รูปแบบข้อมูลไม่ถูกต้อง (ต้องเป็น JSON)' },
      { status: 400 }
    );
  }

  const { productName, quantity, totalPrice, soldAt, items } = body || {};

  const qtyNum = Number(quantity) || (Array.isArray(items) ? items.reduce((sum, i) => sum + (Number(i.quantity) || 0), 0) : 1);
  const totalNum = Number(totalPrice) || 0;
  const safeProductName = String(productName || (items && items[0]?.name) || 'การขายหน้าร้าน').trim();

  const safeItems = Array.isArray(items)
    ? items
        .filter((i) => i && (i.name || i.productName))
        .map((i) => ({
          name: i.name || i.productName || 'สินค้า',
          quantity: Number(i.quantity) || 1,
          unit: typeof i.unit === 'string' ? i.unit : '',
          lineTotal: Number(i.lineTotal || i.price * i.quantity) || 0,
        }))
    : [];

  const text = buildMessage({
    productName: safeProductName,
    quantity: qtyNum,
    totalPrice: totalNum,
    soldAt,
    items: safeItems,
  });

  try {
    const res = await fetch(`https://api.telegram.org/bot${BOT_TOKEN}/sendMessage`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ chat_id: CHAT_ID, text }),
      cache: 'no-store',
    });

    const result = await res.json().catch(() => ({}));

    if (!res.ok || !result.ok) {
      console.error('Telegram API error:', result);
      return NextResponse.json(
        {
          status: 'error',
          message: result.description || `Telegram ตอบกลับสถานะ ${res.status}`,
        },
        { status: 500 }
      );
    }

    return NextResponse.json({ status: 'success' }, { status: 200 });
  } catch (err) {
    console.error('Telegram request failed:', err);
    return NextResponse.json(
      { status: 'error', message: 'เชื่อมต่อ Telegram ไม่สำเร็จ' },
      { status: 500 }
    );
  }
}
