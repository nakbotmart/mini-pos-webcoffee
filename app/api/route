import { NextResponse } from 'next/server';

export const dynamic = 'force-dynamic';

// กำหนด Bot Token และ Chat ID โดยตรงในไฟล์
const BOT_TOKEN = '8951440086:AAE57rVKCJXeJbuVqtn9g1AyhBdv71dG9rU';
const CHAT_ID = '@webcoffeepos';

const formatMoney = (n) =>
  Number(n).toLocaleString('th-TH', {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  });

const formatThaiDateTime = (value) => {
  const date = value ? new Date(value) : new Date();
  const safe = Number.isNaN(date.getTime()) ? new Date() : date;
  return safe.toLocaleString('th-TH', {
    timeZone: 'Asia/Bangkok',
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
  });
};

// สร้างข้อความแจ้งเตือน
function buildMessage({ productName, quantity, totalPrice, soldAt, items }) {
  const lines = ['🛒 ขายสินค้าสำเร็จ!'];

  if (Array.isArray(items) && items.length > 1) {
    lines.push('📦 สินค้า:');
    items.slice(0, 50).forEach((item) => {
      const unit = item.unit ? ` ${item.unit}` : '';
      lines.push(
        `  • ${item.name} x ${item.quantity}${unit} = ${formatMoney(item.lineTotal)} บาท`
      );
    });
    lines.push(`จำนวนรวม: ${quantity}`);
  } else {
    lines.push(`📦 สินค้า: ${productName}`);
    lines.push(`จำนวน: ${quantity}`);
  }

  lines.push(`💰 ยอดรวม: ${formatMoney(totalPrice)} บาท`);
  lines.push(`⏰ เวลา: ${formatThaiDateTime(soldAt)}`);

  // Telegram จำกัดข้อความไม่เกิน 4096 ตัวอักษร
  return lines.join('\n').slice(0, 4000);
}

export async function POST(request) {
  // อ่านและตรวจสอบข้อมูลที่ส่งมา
  let body;
  try {
    body = await request.json();
  } catch {
    return NextResponse.json(
      { status: 'error', message: 'รูปแบบข้อมูลไม่ถูกต้อง (ต้องเป็น JSON)' },
      { status: 400 }
    );
  }

  const { productName, quantity, totalPrice, soldAt, items } = body || {};

  const qtyNum = Number(quantity);
  const totalNum = Number(totalPrice);

  if (
    typeof productName !== 'string' ||
    !productName.trim() ||
    Number.isNaN(qtyNum) ||
    Number.isNaN(totalNum)
  ) {
    return NextResponse.json(
      {
        status: 'error',
        message: 'ข้อมูลไม่ครบ ต้องมี productName, quantity, totalPrice และ soldAt',
      },
      { status: 400 }
    );
  }

  const safeItems = Array.isArray(items)
    ? items
        .filter((i) => i && typeof i.name === 'string')
        .map((i) => ({
          name: i.name,
          quantity: Number(i.quantity) || 0,
          unit: typeof i.unit === 'string' ? i.unit : '',
          lineTotal: Number(i.lineTotal) || 0,
        }))
    : [];

  const text = buildMessage({
    productName: productName.trim(),
    quantity: qtyNum,
    totalPrice: totalNum,
    soldAt,
    items: safeItems,
  });

  // ส่งข้อความไปยัง Telegram Bot API
  try {
    const res = await fetch(`https://api.telegram.org/bot${BOT_TOKEN}/sendMessage`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ chat_id: CHAT_ID, text }),
      cache: 'no-store',
    });

    const result = await res.json().catch(() => ({}));

    if (!res.ok || !result.ok) {
      console.error('Telegram API error:', result);
      return NextResponse.json(
        {
          status: 'error',
          message: result.description || `Telegram ตอบกลับสถานะ ${res.status}`,
        },
        { status: 500 }
      );
    }

    return NextResponse.json({ status: 'success' }, { status: 200 });
  } catch (err) {
    console.error('Telegram request failed:', err);
    return NextResponse.json(
      { status: 'error', message: 'เชื่อมต่อ Telegram ไม่สำเร็จ' },
      { status: 500 }
    );
  }
}
