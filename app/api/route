'use client';

import { useState, useEffect } from 'react';
import { createClient } from '@supabase/supabase-js';

// ตั้งค่า Supabase Client
const supabaseUrl = process.env.NEXT_PUBLIC_SUPABASE_URL;
const supabaseAnonKey = process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY;
const supabase = createClient(supabaseUrl, supabaseAnonKey);

export default function SellPage() {
  const [products, setProducts] = useState([]);
  const [cart, setCart] = useState([]);
  const [loading, setLoading] = useState(false);

  // ดึงรายการสินค้าจาก Supabase
  useEffect(() => {
    fetchProducts();
  }, []);

  const fetchProducts = async () => {
    const { data, error } = await supabase.from('products').select('*');
    if (!error && data) {
      setProducts(data);
    }
  };

  // เพิ่มสินค้าลงตะกร้า
  const addToCart = (product) => {
    setCart((prevCart) => {
      const existing = prevCart.find((item) => item.id === product.id);
      if (existing) {
        return prevCart.map((item) =>
          item.id === product.id ? { ...item, quantity: item.quantity + 1 } : item
        );
      }
      return [...prevCart, { ...product, quantity: 1 }];
    });
  };

  // คำนวณราคารวมทั้งหมด
  const totalPrice = cart.reduce((sum, item) => sum + item.price * item.quantity, 0);

  // ฟังก์ชันยิงแจ้งเตือนเข้า Telegram API Route
  const sendTelegramNotification = async (cartItems, total) => {
    try {
      await fetch('/api/telegram', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          productName: cartItems[0]?.name || 'สินค้าหน้าร้าน',
          quantity: cartItems.reduce((sum, item) => sum + item.quantity, 0),
          totalPrice: total,
          soldAt: new Date().toISOString(),
          items: cartItems.map((item) => ({
            name: item.name,
            quantity: item.quantity,
            unit: 'แก้ว',
            lineTotal: item.price * item.quantity,
          })),
        }),
      });
    } catch (err) {
      console.error('Telegram notification error:', err);
    }
  };

  // ฟังก์ชันกดชำระเงิน / ยืนยันการขาย
  const handleCheckout = async () => {
    if (cart.length === 0) {
      alert('กรุณาเลือกสินค้าก่อนชำระเงิน');
      return;
    }

    setLoading(true);

    try {
      // 1. บันทึกประวัติการขายลงตาราง sales ใน Supabase
      const salesData = cart.map((item) => ({
        product_id: item.id,
        product_name: item.name,
        quantity: item.quantity,
        total_price: item.price * item.quantity,
        created_at: new Date().toISOString(),
      }));

      const { error: saleError } = await supabase.from('sales').insert(salesData);

      if (saleError) {
        throw new Error('บันทึกข้อมูลการขายไม่สำเร็จ: ' + saleError.message);
      }

      // 2. ยิงส่งแจ้งเตือนเข้า Telegram อัตโนมัติ
      await sendTelegramNotification(cart, totalPrice);

      // 3. แสดงข้อความสำเร็จ และล้างตะกร้าสินค้า
      alert('ชำระเงินสำเร็จ และส่งแจ้งเตือนเข้า Telegram เรียบร้อย!');
      setCart([]);
      fetchProducts(); // โหลดสต๊อกใหม่
    } catch (error) {
      alert(error.message);
    } finally {
      setLoading(false);
    }
  };

  return (
    <div style={{ padding: '20px', fontFamily: 'sans-serif' }}>
      <h1>☕ ขายสินค้า (Mini POS)</h1>

      <div style={{ display: 'flex', gap: '20px', marginTop: '20px' }}>
        {/* ฝั่งรายการสินค้า */}
        <div style={{ flex: 2 }}>
          <h2>รายการเมนู</h2>
          <div style={{ display: 'grid', gridTemplateColumns: 'repeat(3, 1fr)', gap: '10px' }}>
            {products.map((p) => (
              <div
                key={p.id}
                onClick={() => addToCart(p)}
                style={{
                  border: '1px solid #ccc',
                  padding: '15px',
                  borderRadius: '8px',
                  cursor: 'pointer',
                  textAlign: 'center',
                }}
              >
                <h3>{p.name}</h3>
                <p>{p.price} บาท</p>
              </div>
            ))}
          </div>
        </div>

        {/* ฝั่งตะกร้าสินค้า */}
        <div style={{ flex: 1, borderLeft: '1px solid #ccc', paddingLeft: '20px' }}>
          <h2>ตะกร้าสินค้า</h2>
          {cart.length === 0 ? (
            <p>ยังไม่มีสินค้าในตะกร้า</p>
          ) : (
            <>
              {cart.map((item) => (
                <div key={item.id} style={{ marginBottom: '10px' }}>
                  <span>{item.name} x {item.quantity}</span>
                  <span style={{ float: 'right' }}>{item.price * item.quantity} บาท</span>
                </div>
              ))}
              <hr />
              <h3>ราคารวม: {totalPrice} บาท</h3>
              <button
                onClick={handleCheckout}
                disabled={loading}
                style={{
                  width: '100%',
                  padding: '12px',
                  backgroundColor: '#28a745',
                  color: 'white',
                  border: 'none',
                  borderRadius: '5px',
                  fontSize: '16px',
                  cursor: 'pointer',
                }}
              >
                {loading ? 'กำลังบันทึก...' : 'ชำระเงิน'}
              </button>
            </>
          )}
        </div>
      </div>
    </div>
  );
}
